<%# app/views/pessoas/show.html.erb %>

<div class="details-wrapper">
  <div class="details-card">
    
    <h1 class="card-title" style="text-align: left; margin-bottom: 30px;">
      <i class="bi bi-person-badge me-2"></i> Dados Cadastrados
    </h1>

    <div class="details-info">
      <p><strong>Nome:</strong> <%= @pessoa.nome %></p>
      <p><strong>CPF:</strong> <%= @pessoa.cpf %></p>
      <p><strong>RG:</strong> <%= @pessoa.rg %></p>
      <p><strong>Email:</strong> <%= @pessoa.email %></p>
      <p><strong>Telefone:</strong> <%= @pessoa.telefone %></p>
    </div>

    <div class="details-actions">
      <%= link_to pessoas_path, class: "btn-back" do %>
        <i class="bi bi-arrow-left"></i> Voltar
      <% end %>
      
      <%= link_to edit_pessoa_path(@pessoa), class: "btn-edit" do %>
        <i class="bi bi-pencil"></i> Editar
      <% end %>
      
      <%= link_to pessoa_path(@pessoa), 
          class: "btn-delete", 
          data: { 
            turbo_method: :delete, 
            turbo_confirm: "Tem certeza que deseja apagar #{@pessoa.nome}?"
          } do %>
        <i class="bi bi-trash"></i> Apagar
      <% end %>
    </div>

  </div>
</div>