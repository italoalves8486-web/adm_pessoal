<div class="page-content">
  <div class="card">
    <h1 class="card-title">Editar Pessoa</h1>
    
    <%# Formulário de edição %>
    <%= render 'form', pessoa: @pessoa %>

    <%# CONTROLLER STIMULUS INICIA AQUI %>
    <div data-controller="confirm-delete">
      <div class="details-actions" style="margin-top: 25px;">
        <%= link_to 'Voltar', pessoas_path, class: "btn-back" %>
        <%= link_to 'Mostrar', @pessoa, class: "btn-edit" %>

      </div>

      <%# MODAL DE CONFIRMAÇÃO %>
      <div id="delete-modal" 
           class="custom-modal" 
           style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 9999; justify-content: center; align-items: center; backdrop-filter: blur(5px);"
           data-confirm-delete-target="modal"
           data-action="click->confirm-delete#clickOutside">
        
        <div class="card" style="max-width: 450px; text-align: center;">
          <h2 class="card-title">Confirmação</h2>
          <p>Você tem certeza que deseja <strong>APAGAR</strong>: <br>
             <span style="color: var(--color-danger);"><%= @pessoa.nome %></span>?</p>

          <div class="details-actions">
            <button type="button" class="btn-back" data-action="confirm-delete#close">Cancelar</button>
            <%= button_to 'Confirmar', @pessoa, method: :delete, class: "btn-delete" %>
          </div>
        </div>
      </div>
    </div>
    <%# FIM DO CONTROLLER %>

  </div>
</div>