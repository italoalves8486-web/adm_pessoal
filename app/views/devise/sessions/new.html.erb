<div class="auth-wrapper">
  <h1 class="auth-main-title">Cadastro de Pessoas</h1>
  


  <div class="auth-card">
    <div class="auth-header">
      <h1>Entrar</h1>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      
      <div class="auth-field">
        <div class="icon-box">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: rgba(0, 0, 0, 1); width: 36px; height: 36px;">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </div>
        <%= f.email_field :email, autofocus: true, placeholder: "E-mail", class: "login-input" %>
      </div>

      <div class="auth-field">
        <div class="icon-box">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: rgba(0, 0, 0, 1); width: 36px; height: 36px;">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <%= f.password_field :password, autocomplete: "current-password", placeholder: "Senha", class: "login-input" %>
      </div>

      <div class="auth-actions">
        <%= f.submit "Entrar", class: "btn-auth" %>
      </div>

      <div class="login-links">
        <%= link_to "Criar conta", new_registration_path(resource_name) %>
        <%= link_to "Esqueceu a senha?", new_password_path(resource_name) %>
      </div>
    <% end %>
  </div>
</div>