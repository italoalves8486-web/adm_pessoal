<div class="auth-wrapper">
  <h1 class="auth-main-title">Cadastro de Usuário</h1>
  <div class="auth-card">
    <div class="auth-header">
      <h1>Sign up</h1>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="auth-field">
        <div class="icon-box">
          </div>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Email", class: "login-input" %>
      </div>

      <div class="auth-field">
        <div class="icon-box"></div>
        <%= f.password_field :password, autocomplete: "new-password", placeholder: "Senha", class: "login-input" %>
      </div>

      <div class="auth-field">
        <div class="icon-box"></div>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirmação de Senha", class: "login-input" %>
      </div>

      <div class="auth-actions">
        <%= f.submit "Sign up", class: "btn-auth" %>
      </div>
    <% end %>

    <div class="login-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>

<script>
  document.querySelector('.background-video').addEventListener('ended', function(e) {
    this.pause(); // Garante que ele pare no último frame disponível
  });
</script>